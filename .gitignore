# Сырые датасеты и данные для разового импорта (data/)
data/

# =============================================================================
# 3. PHP, Composer и серверные зависимости
# =============================================================================
/vendor/
composer.phar
.phpunit.result.cache

# Временные сессии PHP (сохраняем только .gitkeep)
sessions/*
!sessions/.gitkeep

# Логи приложения (сохраняем только .gitkeep)
logs/*
!logs/.gitkeep
*.log
logs/*.txt

# Загруженные пользователями файлы (сохраняем только .gitkeep)
uploads/*
!uploads/.gitkeep

